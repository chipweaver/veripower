# =============================================================================
# FIXED §1.3(b)/(c) lint + CDC ruleset for fa_core_indep adjudication.
#
# The JUDGE's SGDC, NOT an arm's own — supplied to adjudicate.py --fixed, applied
# identically to every arm (§1.3 symmetry). No waivers are loaded (the wrapper's
# run_spyglass.tcl sources none), so this is the raw fixed-ruleset verdict.
#
# Derived from the spec (asic/fa_core_indep/brainstorm.md, "Clocks & Reset"):
# single clock `clk` @ 10 ns, async active-low `rst_n`, single clock domain ⇒ no
# clock-domain crossings this phase (CDC is expected clean by construction).
# =============================================================================

current_design fa_core_indep

clock -name clk   -period 10.0 -edge {0 5.0}
reset -name rst_n -value 0 -async

# Single clock domain (spec D3): every top-level input is synchronous to `clk`.
# Associate the pinned input ports with the clk domain so CDC setup is COMPLETE —
# otherwise Setup_port01 flags them "not fully constrained". This is spec-derived
# (single-domain fact) and keyed only on the pinned port names, so it is
# arm-neutral and applied identically to both arms; it waives no real crossing
# (a single-domain design has none), so it is setup, NOT an arm waiver.
abstract_port -ports qkv_in_data  -scope cdc -clock clk
abstract_port -ports qkv_in_valid -scope cdc -clock clk
abstract_port -ports causal_en    -scope cdc -clock clk
abstract_port -ports o_out_ready  -scope cdc -clock clk
abstract_port -ports rst_n        -scope cdc -clock clk -combo no
