#!SPYGLASS_PROJECT_FILE
#!VERSION 3.0
# SpyGlass project — reads the sourcelist + SGDC, sets top. Edit `top` / paths
# for your design. All paths relative to the directory SpyGlass is invoked from.
read_file -type sourcelist filelist.txt
read_file -type sgdc       constraints/example.sgdc
set_option projectwdir                 ./spyglass_work
set_option language_mode               mixed
set_option designread_enable_synthesis no
set_option enableSV                    yes
set_option enableSV09                  yes
set_option top                         accum
