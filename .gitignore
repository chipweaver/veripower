*.pyc
.pytest_cache/
.venv/

# Claude Code dir: personal settings stay local; shared project config is tracked
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/

# Per-module workspaces
asic/

# Brainstorm specs + implementation plans stay uncommitted by convention
docs/superpowers/

# Defect retrospectives are point-in-time working notes kept out of VCS
docs/retrospective/

# Local test outputs
tests/scenarios/results/

# grill-with-docs outputs — glossary/ADRs kept out of VCS by convention
CONTEXT.md
CONTEXT-MAP.md
docs/adr/

# EDA tool auto-logs at the tree root (belt-and-suspenders; tools write into the
# gitignored per-run workdir under asic/, but an ad-hoc root run must not pollute VCS)
/pt_shell_command.log
/command.log
/*.svf
/*.pvl
/svf.txt
