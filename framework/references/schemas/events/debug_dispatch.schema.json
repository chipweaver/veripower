{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/schemas/events/debug_dispatch.schema.json",
  "title": "debug_dispatch event",
  "description": "events.jsonl record emitted when a debug/triage subagent is dispatched for a module (ts, type, module).",
  "type": "object",
  "required": ["ts", "type", "module"],
  "additionalProperties": true,
  "properties": {
    "ts":             {"type": "string"},
    "type":           {"const": "debug_dispatch"},
    "module":         {"type": "string"},
    "failure_phase":  {"type": "string"}
  }
}
