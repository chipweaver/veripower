{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/schemas/events/debug_result.schema.json",
  "title": "debug_result event",
  "description": "events.jsonl record emitted when a debug/triage run reports its validation outcome (ts, type, validation).",
  "type": "object",
  "required": ["ts", "type", "validation"],
  "additionalProperties": true,
  "properties": {
    "ts":         {"type": "string"},
    "type":       {"const": "debug_result"},
    "validation": {"type": "string", "enum": ["ok", "error"]},
    "root_cause": {"type": "string", "enum": ["rtl-design", "simulation-plan", "specification", "simulation"]}
  }
}
