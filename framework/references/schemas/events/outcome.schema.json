{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/schemas/events/outcome.schema.json",
  "type": "object",
  "required": ["ts", "type", "rule", "run", "verdict", "outputs", "proofs", "tool_versions"],
  "additionalProperties": true,
  "properties": {
    "ts": {"type": "string"},
    "type": {"const": "outcome"},
    "rule": {"type": "string"},
    "run": {"type": "integer", "minimum": 1},
    "verdict": {"type": "string", "enum": ["pass", "fail", "blocked"]},
    "outputs": {"type": "object", "description": "produced version table incl. canonical result.json"},
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "verdict", "inputs", "oracle"],
        "properties": {
          "name": {"type": "string"},
          "verdict": {"type": "string", "enum": ["pass", "fail"]},
          "inputs": {"type": "object"},
          "oracle": {"type": "object", "required": ["ref", "grade"], "properties": {
            "ref": {"type": "string"},
            "grade": {"type": "string", "enum": ["tool", "human", "proposed"]}
          }}
        }
      }
    },
    "tool_versions": {"type": "object"},
    "requirements": {
      "type": "array",
      "description": "Every verdict the run recorded on a ledger row, copied from its result.json at reap. Here rather than left on disk because signoff reads the log, and a verdict a human never sees establishes nothing.",
      "items": {"$ref": "https://veripower.local/schemas/envelope.schema.json#/$defs/requirement_verdict"}
    },
    "reason": {"type": "string", "description": "blocked sub-class (free string): missing / unparseable / malformed / schema_violation / stale_result / produced_at_unparseable / skipped_reason"}
  }
}
