{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/schemas/events/invalidate.schema.json",
  "title": "invalidate event",
  "description": "events.jsonl record emitted when a stage's result is invalidated (ts, type, stage, reason).",
  "type": "object",
  "required": ["ts", "type", "stage", "reason"],
  "additionalProperties": true,
  "properties": {
    "ts":     {"type": "string"},
    "type":   {"const": "invalidate"},
    "stage":  {"type": "string", "enum": ["specification","rtl-design","lint-cdc","simulation-plan","simulation","synthesis","power-analysis","timing-analysis","frontend-signoff"]},
    "reason": {"type": "string", "pattern": ".*\\S.*"}
  }
}
