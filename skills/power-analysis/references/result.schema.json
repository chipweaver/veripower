{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/power-analysis/result.schema.json",
  "title": "power-analysis result.json contract (merged GLS+PT-PX, SAIF flow)",
  "description": "Complete contract for <module>/Verification/power-analysis/result.json. On status=pass, stage_specific requires saif_artifacts + compile_info + failures + requirements + power_by_scenario (compile_info carries vcs_version only). On status=fail, stage_specific.fail_reason is required (if/then below). power_by_scenario carries PT averaged power_mw plus its three components; requirements[] is one verdict per requirements.json row this stage judges,; each verdict carries the measurement behind it in its own `measured`.",
  "allOf": [
    {
      "$ref": "https://veripower.local/schemas/envelope.schema.json"
    },
    {
      "properties": {
        "stage": {
          "const": "power-analysis"
        },
        "stage_specific": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "fix_owner": {
              "type": "string",
              "description": "Repair stage supported by the evidence: this stage or a transitive input producer, checked by the scheduler. Omit when attribution is unresolved."
            },
            "fail_reason": {
              "type": "string",
              "minLength": 1
            },
            "saif_artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "saif_path"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "saif_path": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "compile_info": {
              "type": "object",
              "additionalProperties": false,
              "description": "Identifies the tool that produced the activity, not the one that computed the power: PT prints its own version in the header of every power_flat.rpt these numbers were parsed from.",
              "required": [
                "vcs_version"
              ],
              "properties": {
                "vcs_version": {
                  "type": "string"
                }
              }
            },
            "failures": {
              "type": "array",
              "description": "Tooling/data failures (NOT a missed bound \u2014 that is a requirements[] entry with met=false).",
              "items": {
                "type": "object",
                "required": [
                  "phase",
                  "category",
                  "error_summary"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "phase": {
                    "enum": [
                      "compile",
                      "run",
                      "ptpx",
                      "parse"
                    ]
                  },
                  "category": {
                    "enum": [
                      "saif_dump",
                      "experiment",
                      "ptpx_data"
                    ],
                    "description": "Missing/invalid activity, failed experiment completion, or invalid calculation reports."
                  },
                  "error_summary": {
                    "type": "string"
                  },
                  "log_excerpt": {
                    "type": "string"
                  }
                }
              }
            },
            "power_by_scenario": {
              "type": "array",
              "description": "Measurements by planned scenario. The raw power report records the calculation operating condition.",
              "items": {
                "type": "object",
                "required": [
                  "scenario_id",
                  "power_mw",
                  "internal_mw",
                  "switching_mw",
                  "leakage_mw",
                  "toggled_net_fraction"
                ],
                "properties": {
                  "scenario_id": {
                    "type": "string"
                  },
                  "power_mw": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "internal_mw": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "switching_mw": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "leakage_mw": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "toggled_net_fraction": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Fraction of SAIF TC entries with a nonzero toggle count. Null when activity entries are absent. Interpret against the workload and capture interval; it does not establish useful work."
                  }
                },
                "additionalProperties": false
              }
            },
            "requirements": {
              "type": "array",
              "description": "One verdict per requirement assigned to this stage. Supported numerical targets are computed from reports; other judgments are supplied through finalize --requirements.",
              "items": {
                "$ref": "https://veripower.local/schemas/envelope.schema.json#/$defs/requirement_verdict"
              }
            }
          }
        }
      },
      "required": [
        "stage_specific"
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "saif_artifacts",
              "compile_info",
              "failures",
              "power_by_scenario",
              "requirements"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "fail_reason"
            ]
          }
        }
      }
    }
  ]
}
