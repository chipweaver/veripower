{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conformance-review.schema.json",
  "title": "simulation conformance review (gating reviewer output)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "module", "reviewed_testpoints", "verdict", "has_critical", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"const": "simulation"},
    "module": {"type": "string"},
    "reviewed_testpoints": {"type": "array", "items": {"type": "string"}},
    "verdict": {"enum": ["ok", "concerns"]},
    "has_critical": {"type": "boolean"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tp_id", "severity", "category", "location", "summary"],
        "properties": {
          "tp_id": {"type": "string"},
          "severity": {"enum": ["critical", "important", "minor"]},
          "category": {"enum": ["missing", "wrong-behavior", "fake-green", "unverifiable-arch", "intent-defect", "unavailable"]},
          "location": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
