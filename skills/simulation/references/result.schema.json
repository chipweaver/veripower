{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/simulation/result.schema.json",
  "title": "simulation result.json contract",
  "description": "Functional verification result. A failure records its cause and optional repair owner; the published regression log, case summary and per-test logs contain the case evidence.",
  "allOf": [
    {
      "$ref": "https://veripower.local/schemas/envelope.schema.json"
    },
    {
      "properties": {
        "stage": {
          "const": "simulation"
        },
        "stage_specific": {
          "type": "object",
          "properties": {
            "fix_owner": {
              "type": "string",
              "description": "Repair stage supported by the evidence: this stage or a transitive input producer, checked by the scheduler. Omit when attribution is unresolved."
            },
            "fail_reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "stage_specific"
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "fail_reason"
            ]
          }
        }
      }
    }
  ]
}
