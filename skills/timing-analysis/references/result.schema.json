{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/timing-analysis/result.schema.json",
  "title": "timing-analysis result.json contract",
  "description": "Complete contract for <module>/Design/timing-analysis/result.json. On status=pass, stage_specific.timing carries setup/hold worst-slack + met flag (classified on the report MET/VIOLATED marker) and the boundary-coverage counts. A pass requires both directions MET and every output bit timed — an STA that reached only part of the boundary is not a pass, because the markers describe only the paths it did analyze. On status=fail, stage_specific.fail_reason is required: the one-line cause, which on a run that produced nothing gradeable is all there is. An early fail carries no timing{}, because PT never ran. stage_specific.requirements[] is one verdict per requirements.json row timing-analysis judges, required on pass.",
  "allOf": [
    {
      "$ref": "https://veripower.local/schemas/envelope.schema.json"
    },
    {
      "properties": {
        "stage": {
          "const": "timing-analysis"
        },
        "stage_specific": {
          "type": "object",
          "properties": {
            "fix_owner": {
              "type": "string",
              "description": "Repair stage supported by the evidence: this stage or a transitive input producer, checked by the scheduler. Omit when attribution is unresolved."
            },
            "fail_reason": {
              "type": "string",
              "minLength": 1
            },
            "timing": {
              "type": "object",
              "description": "Structured STA result (required on pass). Worst slack + met flag per direction (classified on the report's MET/VIOLATED marker, never the displayed number), plus the boundary-coverage counts, which are equal on any pass.",
              "required": [
                "setup",
                "hold",
                "coverage"
              ],
              "additionalProperties": false,
              "properties": {
                "setup": {
                  "type": "object",
                  "required": [
                    "worst_slack_ns",
                    "met",
                    "worst_path"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "worst_slack_ns": {
                      "type": "number"
                    },
                    "met": {
                      "type": "boolean"
                    },
                    "worst_path": {
                      "type": "string"
                    }
                  }
                },
                "hold": {
                  "type": "object",
                  "required": [
                    "worst_slack_ns",
                    "met",
                    "worst_path"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "worst_slack_ns": {
                      "type": "number"
                    },
                    "met": {
                      "type": "boolean"
                    },
                    "worst_path": {
                      "type": "string"
                    }
                  }
                },
                "coverage": {
                  "description": "Output-port bit count and PrimeTime out_setup Total. Total includes Untested checks; equality alone does not prove every output was timed. Assess raw coverage and check_timing against the design.",
                  "type": "object",
                  "required": [
                    "output_bits",
                    "output_bits_timed"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "output_bits": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output_bits_timed": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "requirements": {
              "type": "array",
              "description": "One verdict per requirement assigned to this stage. Supported numerical targets are computed from reports; other judgments are supplied through finalize --requirements.",
              "items": {
                "$ref": "https://veripower.local/schemas/envelope.schema.json#/$defs/requirement_verdict"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "stage_specific"
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "timing",
              "requirements"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "fail_reason"
            ]
          }
        }
      }
    }
  ]
}
