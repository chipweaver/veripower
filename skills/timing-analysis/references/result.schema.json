{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/timing-analysis/result.schema.json",
  "title": "timing-analysis result.json contract",
  "description": "Timing measurements and requirement judgments. Setup/hold classify the reported paths. The stage owner assesses analysis scope and exceptions from the native reports and records unresolved issues through fail_reason.",
  "allOf": [
    {
      "$ref": "https://veripower.local/schemas/envelope.schema.json"
    },
    {
      "properties": {
        "stage": {
          "const": "timing-analysis"
        },
        "stage_specific": {
          "type": "object",
          "properties": {
            "fix_owner": {
              "type": "string",
              "description": "Repair stage supported by the evidence: this stage or a transitive input producer, checked by the scheduler. Omit when attribution is unresolved."
            },
            "fail_reason": {
              "type": "string",
              "minLength": 1
            },
            "timing": {
              "type": "object",
              "description": "Reported setup/hold worst slack, marker and path. These measurements do not establish analysis completeness.",
              "required": [
                "setup",
                "hold"
              ],
              "additionalProperties": false,
              "properties": {
                "setup": {
                  "type": "object",
                  "required": [
                    "worst_slack_ns",
                    "met",
                    "worst_path"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "worst_slack_ns": {
                      "type": "number"
                    },
                    "met": {
                      "type": "boolean"
                    },
                    "worst_path": {
                      "type": "string"
                    }
                  }
                },
                "hold": {
                  "type": "object",
                  "required": [
                    "worst_slack_ns",
                    "met",
                    "worst_path"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "worst_slack_ns": {
                      "type": "number"
                    },
                    "met": {
                      "type": "boolean"
                    },
                    "worst_path": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "requirements": {
              "type": "array",
              "description": "One verdict per requirement assigned to this stage. Supported numerical targets are computed from reports; other judgments are supplied through finalize --requirements.",
              "items": {
                "$ref": "https://veripower.local/schemas/envelope.schema.json#/$defs/requirement_verdict"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "stage_specific"
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "timing",
              "requirements"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "fail_reason"
            ]
          }
        }
      }
    }
  ]
}
