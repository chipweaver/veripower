{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/lint-cdc/result.schema.json",
  "title": "lint-cdc result.json contract",
  "description": "Complete contract for <module>/Design/lint-cdc/result.json. stage_specific.violations[] carries the gated rows, severity=error and severity=warning alike (one record per id+rule+severity+reason), so it is required but empty on status=pass, and populated on a rule-based fail; it is not required on an infra/license early-fail, where no report was parsed at all. On status=fail, stage_specific.fail_reason is required (if/then below): the failure narrative, read by the stage this round routes to and parsed by nothing. stage_specific.requirements[] is one verdict per requirements.json row lint-cdc judges, required on pass.",
  "allOf": [
    {
      "$ref": "https://veripower.local/schemas/envelope.schema.json"
    },
    {
      "properties": {
        "stage": {
          "const": "lint-cdc"
        },
        "stage_specific": {
          "type": "object",
          "properties": {
            "fix_owner": {
              "type": "string",
              "description": "Repair stage supported by the evidence: this stage or a transitive input producer, checked by the scheduler. Omit when attribution is unresolved."
            },
            "fail_reason": {
              "type": "string",
              "minLength": 1
            },
            "violations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "rule",
                  "severity",
                  "reason"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "requirements": {
              "type": "array",
              "description": "One verdict per requirement assigned to this stage. Supported numerical targets are computed from reports; other judgments are supplied through finalize --requirements.",
              "items": {
                "$ref": "https://veripower.local/schemas/envelope.schema.json#/$defs/requirement_verdict"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "stage_specific"
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "violations",
              "requirements"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "fail_reason"
            ]
          }
        }
      }
    }
  ]
}
