#!SPYGLASS_PROJECT_FILE
#!VERSION 3.0
# ==============================================================================
# spyglass_lint.prj — SpyGlass project file.
# After deploy, the lint-cdc bootstrap verb substitutes MY_TOP with the actual top
# module name. All paths are relative to the runs/<N>/ deploy directory
# (the cwd from which SpyGlass is invoked).
# ==============================================================================

##Data Import Section
read_file -type sourcelist scripts/filelist.txt
read_file -type sgdc       scripts/constraints.sgdc

##Common Options Section
# Measured, not assumed: each option below was removed on its own from a real
# ChipVerilog i2c lint run and the reported messages compared. Every one of them is
# individually inert on that design — which is what an option that only matters to a
# design shape this one does not have looks like, not a reason to drop it.
set_option projectwdir                  ./spyglass_work
# mixed: the sourcelist may name VHDL beside Verilog.
set_option language_mode                mixed
# The lint goals read RTL; synthesizing it here would only cost time, and flattening
# would lose the hierarchy the per-file messages are reported against.
set_option designread_enable_synthesis  no
set_option designread_disable_flatten   no
# enableSV / enableSV09: SystemVerilog, and its 2009 additions. SpyGlass prints
# "Option 'enableSV' ignored as another option(s) 'enableSV09' have been specified"
# on every run, and `stop` is listed as an unused specification in stop_summary.rpt.
# Neither message means the line is dead: removing either alone changes nothing, and
# removing BOTH loses a real CheckDelayTimescale-ML warning on i2c_master_bit_ctrl.v,
# reproducibly, while removing any other two (or three) options does not. Keep the pair.
set_option enableSV                     yes
set_option enableSV09                   yes
# sort: report messages in a stable order, so two runs of the same design diff cleanly.
set_option sort                         yes
set_option stop                         {no}
# allow_module_override: a design that defines a module name twice is read rather than
# refused, so lint gets to say so instead of the project failing to open.
set_option allow_module_override        yes
set_option top                          MY_TOP
