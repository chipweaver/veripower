#!SPYGLASS_PROJECT_FILE
#!VERSION 3.0
# ==============================================================================
# spyglass_lint.prj — SpyGlass project file.
# After deploy, the lint-cdc bootstrap verb substitutes MY_TOP with the actual top
# module name. All paths are relative to the runs/<N>/ deploy directory
# (the cwd from which SpyGlass is invoked).
# ==============================================================================

##Data Import Section
read_file -type sourcelist scripts/filelist.txt
read_file -type sgdc       scripts/constraints.sgdc

##Common Options Section
# Measured against a real ChipVerilog i2c lint run, one option removed at a time: each is
# inert on its own there. That is what an option matters-to-a-shape-this-design-lacks looks
# like, not a reason to drop it, and the two notes below are the cases where removing one
# does change the result.
set_option projectwdir                  ./spyglass_work
set_option language_mode                mixed
set_option designread_enable_synthesis  no
set_option designread_disable_flatten   no
# Neither of these two lines is dead, whatever the run says about them. SpyGlass prints
# "Option 'enableSV' ignored as another option(s) 'enableSV09' have been specified" every
# time, and lists `stop` as an unused specification in stop_summary.rpt. Removing either
# alone changes nothing; removing BOTH loses a real CheckDelayTimescale-ML warning on
# i2c_master_bit_ctrl.v, reproducibly, where removing any other two or three does not.
set_option enableSV                     yes
set_option enableSV09                   yes
set_option sort                         yes
set_option stop                         {no}
# Load-bearing on a file set that defines a module name twice: with it, that design reads
# and lints normally; without it lint reports nothing at all — no error, an empty report,
# exit 0.
set_option allow_module_override        yes
set_option top                          MY_TOP
