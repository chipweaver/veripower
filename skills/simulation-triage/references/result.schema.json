{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/simulation-triage/result.schema.json",
  "title": "simulation-triage result.json contract (schema_version 1)",
  "description": "Complete contract for asic/<module>/Verification/simulation-triage/result.json (Task C7: folds the retired standalone analysis.schema.json — and the runs/<sim_run>/analysis.json + top-level analysis.json pointer double-file mechanism it gated — into this single result.json's stage_specific; single source of truth from here on). stage_specific carries the two-tier analysis verbatim: the routing tier (analysis_state/root_cause/confidence) that framework/scripts/kernel.py's reap-time _derive_triage and route.py consume to mint a diagnosis event or escalate, and the advisory tier (advisory.{level, fix_direction, findings[], waveform, experiment}) forwarded to the rework target as directive context — persisted, non-gating. analysis_state discriminates: 'complete' carries root_cause + confidence; 'skipped' carries skipped_reason. confidence is a hard, gating routing field: high auto-routes, medium/low escalate to the operator.",
  "allOf": [
    {"$ref": "https://veripower.local/schemas/envelope.schema.json"},
    {
      "properties": {
        "stage": {"const": "simulation-triage"},
        "stage_specific": {
          "type": "object",
          "required": ["analysis_state"],
          "properties": {
            "analysis_state": {"type": "string", "enum": ["complete", "skipped"]},
            "skipped_reason": {"type": "string", "minLength": 1},
            "root_cause":     {"type": "string", "enum": ["rtl-design", "simulation-plan", "specification", "simulation"]},
            "confidence":     {"type": "string", "enum": ["high", "medium", "low"]},
            "advisory": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "level":         {"type": "string", "enum": ["L1", "L2"]},
                "fix_direction": {"type": "string"},
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "properties": {
                      "fault_type": {"type": "string"},
                      "anchor":     {"type": "string"},
                      "cases":      {"type": "array", "items": {"type": "string"}}
                    }
                  }
                },
                "waveform": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "commands":    {"type": "array", "items": {"type": "string"}},
                    "signals":     {"type": "array", "items": {"type": "string"}},
                    "observation": {"type": "string"}
                  }
                },
                "experiment": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "tool":       {"type": "string"},
                    "stimulus":   {"type": "string"},
                    "artifacts":  {"type": "array", "items": {"type": "string"}},
                    "golden":     {"type": "string"},
                    "conclusion": {"type": "string"}
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if":   {"properties": {"analysis_state": {"const": "complete"}}, "required": ["analysis_state"]},
              "then": {"required": ["root_cause", "confidence"]}
            },
            {
              "if":   {"properties": {"analysis_state": {"const": "skipped"}}, "required": ["analysis_state"]},
              "then": {"required": ["skipped_reason"]}
            }
          ],
          "additionalProperties": false
        }
      },
      "required": ["stage_specific"]
    }
  ]
}
