{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/simulation-plan/result.schema.json",
  "title": "simulation-plan result.json contract (schema_version 1)",
  "description": "Complete contract for asic/<module>/Verification/simulation-plan/result.json. On status=fail, stage_specific.fail_reason is required (if/then below) — the one-line failure narrative. Optional informational counts (testpoint_count / feature_count / scaffold_summary / power_scenario_count) may be present for status-panel display and simulation-triage prompt context; canonical structured data still lives in scaffold-specification.json and is NOT duplicated here.",
  "allOf": [
    {"$ref": "https://veripower.local/schemas/envelope.schema.json"},
    {
      "properties": {
        "schema_version": {"const": 1},
        "stage": {"const": "simulation-plan"},
        "stage_specific": {
          "type": "object",
          "properties": {
            "fail_reason":          {"type": "string",  "minLength": 1},
            "testpoint_count":      {"type": "integer", "minimum": 0},
            "feature_count":        {"type": "integer", "minimum": 0},
            "scaffold_summary": {
              "type": "object",
              "properties": {
                "agent_count":    {"type": "integer", "minimum": 0},
                "sequence_count": {"type": "integer", "minimum": 0},
                "test_count":     {"type": "integer", "minimum": 0}
              },
              "additionalProperties": true
            },
            "power_scenario_count": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "required": ["schema_version", "stage_specific"]
    },
    {
      "if":   {"properties": {"status": {"const": "fail"}}, "required": ["status"]},
      "then": {"properties": {"stage_specific": {"required": ["fail_reason"]}}}
    }
  ]
}
