{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/simulation-plan/result.schema.json",
  "title": "simulation-plan result.json contract (schema_version 1)",
  "description": "Complete contract for asic/<module>/Verification/simulation-plan/result.json. On status=pass, stage_specific carries the plan_adequacy_gate verdict; on status=fail, fail_reason (the one-line failure narrative).",
  "allOf": [
    {"$ref": "https://veripower.local/schemas/envelope.schema.json"},
    {
      "properties": {
        "stage": {"const": "simulation-plan"},
        "stage_specific": {
          "type": "object",
          "properties": {
            "fail_reason":          {"type": "string",  "minLength": 1},
            "plan_adequacy_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["gate"],
              "properties": {
                "gate":     {"enum": ["trip", "clear"]},
                "flagged":  {"type": "array", "items": {
                  "type": "object",
                  "properties": {
                    "tp_id":    {"type": "string"},
                    "lens":     {"type": "string"},
                    "severity": {"type": "string"}
                  }
                }},
                "must_ack": {"type": "array", "items": {
                  "type": "object",
                  "properties": {
                    "tp_id":    {"type": "string"},
                    "severity": {"type": "string"}
                  }
                }},
                "waived": {"type": "array", "items": {
                  "type": "object",
                  "properties": {
                    "tp_id":          {"type": "string"},
                    "lens":           {"type": "string"},
                    "location":       {"type": "string"},
                    "classification": {"enum": ["false-positive", "accepted-risk"]},
                    "reason":         {"type": "string"}
                  }
                }}
              }
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["stage_specific"]
    },
    {
      "if":   {"properties": {"status": {"const": "fail"}}, "required": ["status"]},
      "then": {"properties": {"stage_specific": {"required": ["fail_reason"]}}}
    }
  ]
}
