{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec-review.schema.json",
  "title": "specification semantic review (gating reviewer output)",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "module", "findings"],
  "properties": {
    "stage": {"const": "specification"},
    "module": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["child", "lens", "severity", "location", "summary"],
        "properties": {
          "child": {"type": "string"},
          "lens": {"enum": ["faithfulness", "conformance", "soundness", "unavailable"]},
          "severity": {"enum": ["critical", "important", "minor"]},
          "location": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    }
  }
}
