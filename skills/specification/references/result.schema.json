{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/specification/result.schema.json",
  "title": "specification result.json contract (schema_version 1)",
  "description": "Complete contract for asic/<module>/Design/specification/result.json. On status=pass, stage_specific carries top_module (filename-convention anchor for <TOP>.sdc/.sgdc); the PPA gate targets live in the ppa.json sidecar (ppa.schema.json) that synthesis/power-analysis read directly, not in this envelope. Other design data (interfaces, clock_domains, reset strategy) lives canonical in design.md and is not duplicated here. On status=fail, stage_specific.fail_reason is required (if/then below) — the one-line failure narrative. top_module may be absent if the early-fail path didn't reach scaffold-derivation.",
  "allOf": [
    {"$ref": "https://veripower.local/schemas/envelope.schema.json"},
    {
      "properties": {
        "stage": {"const": "specification"},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path":   {"type": "string", "minLength": 1},
              "kind":   {"type": "string"}
            }
          }
        },
        "stage_specific": {
          "type": "object",
          "properties": {
            "top_module":  {"type": "string", "minLength": 1},
            "fail_reason": {"type": "string", "minLength": 1},
            "spec_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["gate"],
              "properties": {
                "gate":     {"enum": ["trip", "clear"]},
                "flagged":  {"type": "array", "items": {
                  "type": "object",
                  "properties": {
                    "child":    {"type": "string"},
                    "lens":     {"type": "string"},
                    "severity": {"type": "string"}
                  }
                }},
                "must_ack": {"type": "array", "items": {
                  "type": "object",
                  "properties": {
                    "child":    {"type": "string"},
                    "severity": {"type": "string"}
                  }
                }},
                "waived": {"type": "array", "items": {
                  "type": "object",
                  "properties": {
                    "child":          {"type": "string"},
                    "lens":           {"type": "string"},
                    "location":       {"type": "string"},
                    "classification": {"enum": ["false-positive", "accepted-risk"]},
                    "reason":         {"type": "string"}
                  }
                }}
              }
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["stage_specific"]
    },
    {
      "if":   {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {"properties": {"stage_specific": {"required": ["top_module"]}}}
    },
    {
      "if":   {"properties": {"status": {"const": "fail"}}, "required": ["status"]},
      "then": {"properties": {"stage_specific": {"required": ["fail_reason"]}}}
    }
  ]
}
