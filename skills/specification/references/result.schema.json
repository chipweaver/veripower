{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veripower.local/skills/specification/result.schema.json",
  "title": "specification result.json contract",
  "description": "Complete contract for <module>/Design/specification/result.json. On status=fail, stage_specific.fail_reason is required: the one-line failure narrative. TOP is not restated here — it is manifest.module, which every downstream rule declares as an input and reads there. The semantic review lives in artifacts[] as spec-review/findings/*.md — prose, not a verdict field.",
  "allOf": [
    {
      "$ref": "https://veripower.local/schemas/envelope.schema.json"
    },
    {
      "properties": {
        "stage": {
          "const": "specification"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "stage_specific": {
          "type": "object",
          "properties": {
            "fail_reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "stage_specific"
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "stage_specific": {
            "required": [
              "fail_reason"
            ]
          }
        }
      }
    }
  ]
}
