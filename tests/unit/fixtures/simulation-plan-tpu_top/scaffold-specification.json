  "testpoints": [
    {
      "id": "TP-MAC-FUNC",
      "intent": "Registered MAC compute and data forwarding across all four cells; array result outputs out1/out2 observed via o_prdata read-back.",
      "bins": [
        "mac00",
        "mac01",
        "mac10",
        "mac11",
        "data_forward"
      ],
      "covers": [
        "CHK-MAC-01",
        "CHK-MAC-02",
        "CHK-MAC-05"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-MAC-01",
          "implementation_detail": "every clock (async active-low reset → 0): `o_result <= (i_data * i_weight) + i_pre_result` (registered)",
          "observable": "`o_result` (`mac00_out`/`mac01_out`/`out1`/`out2`)",
          "reference_rule": "`o_result_next = (i_data * i_weight) + i_pre_result`, truncated/wrapped to 32 bits",
          "latency": "1 cycle",
          "reset_behavior": "`o_result <= 0` on `negedge i_rstn`"
        },
        {
          "check_id": "CHK-MAC-02",
          "implementation_detail": "`o_data_next <= i_data` (registered, forwards data to the next cell)",
          "observable": "`o_data_next` (`mac01_in`/`mac11_in`)",
          "reference_rule": "`o_data_next_next = i_data`",
          "latency": "1 cycle",
          "reset_behavior": "`o_data_next <= 0` on `negedge i_rstn`"
        },
        {
          "check_id": "CHK-MAC-05",
          "implementation_detail": "`o_result <= (i_data * i_weight) + i_pre_result` (registered) — column chain `mac00_out`→`mac_10.i_pre_result`, `mac01_out`→`mac_11.i_pre_result`",
          "observable": "`out1` (`mac_10.o_result`), `out2` (`mac_11.o_result`)",
          "reference_rule": "`out1 = (mac10.i_data * mem[2]) + mac00_out`; `out2 = (mac11.i_data * mem[3]) + mac01_out`",
          "latency": "1 cycle per cell",
          "reset_behavior": "`o_result <= 0` on `negedge i_rstn`"
        }
      ]
    },
    {
      "id": "TP-MAC-PARTIALSUM",
      "intent": "Partial-sum chaining: top-row seed 32'h0 into i_pre_result and accumulate MSBs.",
      "bins": [
        "seed_zero",
        "msb_accumulate"
      ],
      "covers": [
        "CHK-MAC-03",
        "CHK-MAC-04"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-MAC-03",
          "implementation_detail": "The product `i_data * i_weight` is a 32-bit multiply truncated to 32 bits; the accumulate is 32-bit and **wraps** (no saturation).",
          "observable": "`o_result` MSBs",
          "reference_rule": "`o_result = ((i_data * i_weight) + i_pre_result) mod 2^32`",
          "latency": "1 cycle",
          "reset_behavior": "`o_result <= 0` on `negedge i_rstn`"
        },
        {
          "check_id": "CHK-MAC-04",
          "implementation_detail": "`i_pre_result = 0` (top-row cells `mac_00`/`mac_01`) → cell acts as a pure multiply into the partial-sum chain.",
          "observable": "`mac00_out`/`mac01_out` with `32'h0` tie",
          "reference_rule": "for `mac_00`/`mac_01`: `o_result = (i_data * i_weight) + 0` (i_pre_result tied `32'h0`)",
          "latency": "1 cycle",
          "reset_behavior": "`o_result <= 0` on `negedge i_rstn`"
        }
      ]
    },
    {
      "id": "TP-MAC-WRAP",
      "intent": "32-bit multiply/accumulate wrap on overflow (no saturation).",
      "bins": [
        "overflow_wrap"
      ],
      "covers": [
        "CHK-MAC-06"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-MAC-06",
          "implementation_detail": "Negative case: product/sum exceeding 32 bits wraps — accepted by design.",
          "observable": "`o_result` on overflow stimulus",
          "reference_rule": "result wraps modulo 2^32; no saturation, no error flag",
          "latency": "1 cycle",
          "reset_behavior": "`o_result <= 0` on `negedge i_rstn`"
        }
      ]
    },
    {
      "id": "TP-MAC-UNCONNECTED",
      "intent": "Intentionally-unconnected mac_01/mac_11 o_data_next must not affect results.",
      "bins": [
        "unconnected_forward"
      ],
      "covers": [
        "CHK-MAC-07"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-MAC-07",
          "implementation_detail": "`o_data_next <= i_data` (registered) — `mac_01.o_data_next` / `mac_11.o_data_next` intentionally unconnected",
          "observable": "`mac_01.o_data_next`, `mac_11.o_data_next` (no consumer)",
          "reference_rule": "output left dangling by design; not a connectivity error",
          "latency": "1 cycle",
          "reset_behavior": "`o_data_next <= 0` on `negedge i_rstn`"
        }
      ]
    },
    {
      "id": "TP-SREG-SKEW",
      "intent": "Skew alignment: out1=in1 delayed 1 cycle, out2=in2 delayed 2 cycles, staggered wavefront.",
      "bins": [
        "delay1",
        "delay2",
        "wavefront_align"
      ],
      "covers": [
        "CHK-SREG-01",
        "CHK-SREG-02",
        "CHK-SREG-04"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-SREG-01",
          "implementation_detail": "`out1` = `in1` delayed **1** cycle (one register `delay10`); `delay10 <= in1`; `out1 = delay10`",
          "observable": "`out1` (`mac00_in`)",
          "reference_rule": "out1[t] == in1[t-1]",
          "latency": "1 cycle",
          "reset_behavior": "`delay10` cleared to 0 on async active-low reset (`negedge i_rstn`)"
        },
        {
          "check_id": "CHK-SREG-02",
          "implementation_detail": "`out2` = `in2` delayed **2** cycles (two registers `delay20` → `delay21`); `delay20 <= in2`; `delay21 <= delay20`; `out2 = delay21`",
          "observable": "`out2` (`mac10_in`)",
          "reference_rule": "out2[t] == in2[t-2]",
          "latency": "2 cycle",
          "reset_behavior": "`delay20` and `delay21` cleared to 0 on async active-low reset (`negedge i_rstn`)"
        },
        {
          "check_id": "CHK-SREG-04",
          "implementation_detail": "`out1` = `in1` delayed **1** cycle (one register `delay10`); `out2` = `in2` delayed **2** cycles (two registers `delay20` → `delay21`)",
          "observable": "`out1` (`mac00_in`), `out2` (`mac10_in`)",
          "reference_rule": "for pair presented at t: out1 valid at t+1, out2 valid at t+2 (out1 leads out2 by 1)",
          "latency": "1 cycle (lead)",
          "reset_behavior": "both lines restart latency from reset-release edge after `delay10`/`delay20`/`delay21` cleared to 0"
        }
      ]
    },
    {
      "id": "TP-SREG-RESET",
      "intent": "Async active-low reset clears delay10/delay20/delay21 to 0 mid-stream.",
      "bins": [
        "reset_clear"
      ],
      "covers": [
        "CHK-SREG-03"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-SREG-03",
          "implementation_detail": "Async active-low reset clears all skew registers to 0; `delay10`/`delay20`/`delay21` <= 0 on `negedge i_rstn`",
          "observable": "`delay10`, `delay20`, `delay21`, `out1`, `out2`",
          "reference_rule": "on i_rstn==0: delay10==delay20==delay21==0 → out1==out2==0",
          "latency": "0 cycle (async)",
          "reset_behavior": "all skew registers (`delay10`, `delay20`, `delay21`) = 0"
        }
      ]
    },
    {
      "id": "TP-FIFO-WR",
      "intent": "Write on i_wr & !o_full into mem[wr_addr]; wr_addr advances.",
      "bins": [
        "write"
      ],
      "covers": [
        "CHK-FIFO-01"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-FIFO-01",
          "implementation_detail": "Write on `i_wr & !o_full` → `mem[wr_addr]`; `wr_addr` advances on the same",
          "observable": "`mem[wr_addr]`, `wr_addr`",
          "reference_rule": "FIFO write/order contract",
          "latency": "1 cycle (registered write)",
          "reset_behavior": "`mem`, `wr_addr` cleared to 0 on async active-low reset"
        }
      ]
    },
    {
      "id": "TP-FIFO-RD",
      "intent": "Combinational read o_data=mem[rd_addr]; rd_addr advances on i_rd & !o_empty; FIFO-order sequence.",
      "bins": [
        "read",
        "fifo_order"
      ],
      "covers": [
        "CHK-FIFO-02",
        "CHK-FIFO-03",
        "CHK-FIFO-07"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-FIFO-02",
          "implementation_detail": "`rd_addr` advances on `i_rd & !o_empty`",
          "observable": "`rd_addr`",
          "reference_rule": "FIFO pop contract",
          "latency": "1 cycle (registered pointer)",
          "reset_behavior": "`rd_addr` cleared to 0 on async active-low reset"
        },
        {
          "check_id": "CHK-FIFO-03",
          "implementation_detail": "Read is **combinational**: `o_data = mem[rd_addr]`",
          "observable": "`o_data`",
          "reference_rule": "combinational read",
          "latency": "0 cycle (combinational)",
          "reset_behavior": "After reset `o_data = mem[rd_addr]` with `rd_addr=0`"
        },
        {
          "check_id": "CHK-FIFO-07",
          "implementation_detail": "Happy path: write then read returns the written word in FIFO order",
          "observable": "`o_data` sequence",
          "reference_rule": "FIFO ordering",
          "latency": "per pop (combinational `o_data`)",
          "reset_behavior": "sequence restarts from 0 after reset"
        }
      ]
    },
    {
      "id": "TP-FIFO-FLAGS",
      "intent": "Flag generation compared directly: o_empty=(wr_addr==rd_addr), o_full=((wr_addr+1)==rd_addr); RM predicts o_full/o_empty per cycle, scoreboard compares against DUT status outputs.",
      "bins": [
        "empty",
        "full"
      ],
      "covers": [
        "CHK-FIFO-04",
        "CHK-FIFO-05"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-FIFO-04",
          "implementation_detail": "`o_empty = (wr_addr == rd_addr)`",
          "observable": "`o_empty`",
          "reference_rule": "empty-flag contract",
          "latency": "0 cycle (combinational)",
          "reset_behavior": "`o_empty` high after reset (`wr_addr==rd_addr==0`)"
        },
        {
          "check_id": "CHK-FIFO-05",
          "implementation_detail": "`o_full  = ((wr_addr + 1) == rd_addr)`",
          "observable": "`o_full`",
          "reference_rule": "full-flag contract (one slot reserved)",
          "latency": "0 cycle (combinational)",
          "reset_behavior": "`o_full` low after reset"
        }
      ]
    },
    {
      "id": "TP-FIFO-BOUNDARY",
      "intent": "Write-while-full and read-while-empty are ignored (pointers do not advance).",
      "bins": [
        "write_full_ignored",
        "read_empty_ignored"
      ],
      "covers": [
        "CHK-FIFO-08"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-FIFO-08",
          "implementation_detail": "`o_full`/`o_empty` use 3-bit pointer wrap (modulo-8); the `(wr_addr+1)==rd_addr` full condition is part of the contract",
          "observable": "`wr_addr`, `rd_addr`, `o_full`, `o_empty`",
          "reference_rule": "modulo-8 wrap contract",
          "latency": "0 cycle (flags combinational)",
          "reset_behavior": "pointers wrap from 0 after reset"
        }
      ]
    },
    {
      "id": "TP-FIFO-WRAP",
      "intent": "Modulo-8 (3-bit) pointer wrap.",
