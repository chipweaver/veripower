    {
      "id": "TP-APB-WRITE",
      "intent": "APB weight load to mem[i_paddr]; address map W00=0,W01=1,W10=2,W11=3.",
      "bins": [
        "w00",
        "w01",
        "w10",
        "w11"
      ],
      "covers": [
        "CHK-TOP-01",
        "CHK-TOP-03"
      ],
      "inlined_check_hints": [
        {
          "check_id": "CHK-TOP-01",
          "implementation_detail": "`write_enb = i_psel & i_penable & i_pwrite` → `mem[i_paddr] <= i_pwdata` (clocked, **no reset** on this block — faithful to the reference)",
          "observable": "`mem[i_paddr]` (`mem[0]`/`mem[1]`/`mem[2]`/`mem[3]`) → MAC `i_weight`",
          "reference_rule": "on write_enb: mem[i_paddr][t+1] == i_pwdata[t]",
          "latency": "1 cycle",
          "reset_behavior": "NOT reset by `i_rstn`; clocked-only, retains last value"
        },
        {
          "check_id": "CHK-TOP-03",
          "implementation_detail": "APB address map: `W00 = 0`, `W01 = 1`, `W10 = 2`, `W11 = 3`",
          "observable": "`mem[0]`, `mem[1]`, `mem[2]`, `mem[3]`",
          "reference_rule": "i_paddr∈{0,1,2,3} maps to mem[0..3] = W00/W01/W10/W11",
          "latency": "1 cycle (write)",
          "reset_behavior": "mem not reset (clocked-only)"
        }
      ]
    },
    {
      "id": "TP-APB-READ",
      "intent": "APB read returns next result-FIFO word via o_prdata and advances fifo_result read pointer; o_prdata=0 when no read.",
      "bins": [
        "read_word",
        "no_read_zero"
      ],
      "covers": [
        "CHK-TOP-02"
      ],
      "inlined_check_hints": [
        {
